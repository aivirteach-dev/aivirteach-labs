# 复制为本目录下的 .env.monitoring（已被 .gitignore 忽略），权限设为 600：
#   cp deploy/monitoring.env.example .env.monitoring && chmod 600 .env.monitoring
# 这里全是密钥，不要提交、不要发到聊天里。

# 签名登录令牌用。生成：openssl rand -hex 32
PHOENIX_SECRET=

# 管理员 admin@localhost 的初始密码，只在第一次启动时生效。
# 至少 12 位，含大写、小写、数字和特殊字符。生成示例：echo "Aa1!$(openssl rand -base64 18)"
PHOENIX_ADMIN_INITIAL_PASSWORD=

# Collector 写入 Phoenix 用的系统 API key。首次部署先留空，登录 Phoenix 后在
# Settings → API Keys → System Keys 创建（名称如 otel-collector），填到这里再重启 otel-collector。
PHOENIX_API_KEY=

# 告警通知：默认不发通知（告警只显示在 Alertmanager 界面）。配置邮件或企业微信后改为
# ALERTMANAGER_CONFIG=./.alertmanager.yml，见 deploy/alertmanager.example.yml。
# ALERTMANAGER_CONFIG=./.alertmanager.yml

# 可选
# PHOENIX_RETENTION_DAYS=30
# PHOENIX_STORAGE_GIB=10
# PHOENIX_MEM_LIMIT=1g
# PHOENIX_UI_PORT=6006
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=2GB
# PROMETHEUS_UI_PORT=9090
# ALERTMANAGER_UI_PORT=9093
