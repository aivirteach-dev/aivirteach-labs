{
  "api_version": "dsh-tutor.v1",
  "submission": {
    "$defs": {
      "HistorySelection": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "recent",
            "enum": [
              "recent",
              "earlier",
              "none"
            ],
            "title": "Mode",
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Before"
          }
        },
        "title": "HistorySelection",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "api_version": {
        "const": "dsh-tutor.v1",
        "title": "Api Version",
        "type": "string"
      },
      "profile": {
        "default": "course_snapshot",
        "enum": [
          "course_snapshot",
          "aivirteach",
          "course_actions_v1"
        ],
        "title": "Profile",
        "type": "string"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "request_window_id": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Request Window Id"
      },
      "history_selection": {
        "$ref": "#/$defs/HistorySelection"
      }
    },
    "required": [
      "api_version",
      "payload"
    ],
    "title": "Submission",
    "type": "object"
  },
  "operation_view": {
    "$defs": {
      "AnswerQuality": {
        "description": "区分可验证事实与受限说明；不表示任意自然语言或课程相关性已被证明。",
        "properties": {
          "facts": {
            "default": "not_requested",
            "enum": [
              "not_requested",
              "verified",
              "unavailable",
              "rejected"
            ],
            "title": "Facts",
            "type": "string"
          },
          "explanation": {
            "default": "not_checked",
            "enum": [
              "not_checked",
              "validated_selection",
              "omitted"
            ],
            "title": "Explanation",
            "type": "string"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "title": "Issues",
            "type": "array"
          }
        },
        "title": "AnswerQuality",
        "type": "object"
      },
      "ContextUsage": {
        "description": "仅返回计数和原因，便于排错；不把原文或身份扩散到进度看板。",
        "properties": {
          "received_turns": {
            "title": "Received Turns",
            "type": "integer"
          },
          "used_turns": {
            "title": "Used Turns",
            "type": "integer"
          },
          "discarded_scope": {
            "title": "Discarded Scope",
            "type": "integer"
          },
          "discarded_budget": {
            "title": "Discarded Budget",
            "type": "integer"
          },
          "history_chars": {
            "title": "History Chars",
            "type": "integer"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "title": "Issues",
            "type": "array"
          },
          "current_state_policy": {
            "const": "fresh_tool_evidence_only",
            "default": "fresh_tool_evidence_only",
            "title": "Current State Policy",
            "type": "string"
          }
        },
        "required": [
          "received_turns",
          "used_turns",
          "discarded_scope",
          "discarded_budget",
          "history_chars"
        ],
        "title": "ContextUsage",
        "type": "object"
      },
      "CourseAnswer": {
        "description": "包含模拟工具证据及有限质量状态；不代表完整VM诊断或学生过关。",
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "execution_path": {
            "default": "model",
            "enum": [
              "model",
              "direct"
            ],
            "title": "Execution Path",
            "type": "string"
          },
          "direct_action_kind": {
            "anyOf": [
              {
                "enum": [
                  "material_block",
                  "learning_goal",
                  "service_status"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Direct Action Kind"
          },
          "memory_revision": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Memory Revision"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "context_usage": {
            "anyOf": [
              {
                "$ref": "#/$defs/ContextUsage"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "runtime_metrics": {
            "anyOf": [
              {
                "$ref": "#/$defs/RuntimeMetrics"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "quality": {
            "$ref": "#/$defs/AnswerQuality"
          },
          "status": {
            "default": "completed",
            "enum": [
              "completed",
              "partial"
            ],
            "title": "Status",
            "type": "string"
          },
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "elapsed_seconds": {
            "title": "Elapsed Seconds",
            "type": "number"
          },
          "tool_calls": {
            "default": 0,
            "title": "Tool Calls",
            "type": "integer"
          },
          "tool_attempts": {
            "default": 0,
            "title": "Tool Attempts",
            "type": "integer"
          },
          "tool_trace": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tool Trace",
            "type": "array"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Evidence",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "answer",
          "model",
          "elapsed_seconds"
        ],
        "title": "CourseAnswer",
        "type": "object"
      },
      "EventPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/OperationEvent"
            },
            "maxItems": 32,
            "title": "Items",
            "type": "array"
          },
          "next_after": {
            "exclusiveMaximum": 9223372036854775808,
            "minimum": 0,
            "title": "Next After",
            "type": "integer"
          },
          "reset_required": {
            "title": "Reset Required",
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "next_after",
          "reset_required"
        ],
        "title": "EventPage",
        "type": "object"
      },
      "OperationEvent": {
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "exclusiveMaximum": 9223372036854775808,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "accepted",
              "stage",
              "cancel_requested",
              "succeeded",
              "failed",
              "recovery_required",
              "interrupted",
              "reconciled",
              "redacted"
            ],
            "title": "Kind",
            "type": "string"
          },
          "stage": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Stage",
            "type": "string"
          },
          "code": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Code"
          },
          "created_at": {
            "maxLength": 64,
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "kind",
          "stage",
          "created_at"
        ],
        "title": "OperationEvent",
        "type": "object"
      },
      "OperationResult": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "answer_status": {
            "enum": [
              "completed",
              "partial"
            ],
            "title": "Answer Status",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run Id"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "$ref": "#/$defs/CourseAnswer"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "$ref": "#/$defs/TokenUsage"
          },
          "evidence_scope": {
            "const": "original_run_only",
            "default": "original_run_only",
            "title": "Evidence Scope",
            "type": "string"
          },
          "persistence": {
            "$ref": "#/$defs/PersistenceState"
          }
        },
        "required": [
          "answer",
          "answer_status",
          "replayed",
          "detail",
          "usage",
          "persistence"
        ],
        "title": "OperationResult",
        "type": "object"
      },
      "PersistenceState": {
        "additionalProperties": false,
        "properties": {
          "agent_chat": {
            "const": "saved",
            "default": "saved",
            "title": "Agent Chat",
            "type": "string"
          },
          "operation_record": {
            "const": "saved",
            "default": "saved",
            "title": "Operation Record",
            "type": "string"
          },
          "platform": {
            "const": "unconfirmed",
            "default": "unconfirmed",
            "title": "Platform",
            "type": "string"
          }
        },
        "title": "PersistenceState",
        "type": "object"
      },
      "RuntimeMetrics": {
        "additionalProperties": false,
        "description": "仅数值/有限枚举，不带提示词、学生、文件路径或远端原始异常。",
        "properties": {
          "version": {
            "const": 1,
            "default": 1,
            "title": "Version",
            "type": "integer"
          },
          "source": {
            "const": "installed_dsh_guard",
            "default": "installed_dsh_guard",
            "title": "Source",
            "type": "string"
          },
          "model_calls": {
            "maximum": 16,
            "minimum": 0,
            "title": "Model Calls",
            "type": "integer"
          },
          "input_estimated_tokens": {
            "maximum": 2097152,
            "minimum": 0,
            "title": "Input Estimated Tokens",
            "type": "integer"
          },
          "output_reserved_tokens": {
            "maximum": 65536,
            "minimum": 0,
            "title": "Output Reserved Tokens",
            "type": "integer"
          },
          "output_bytes": {
            "maximum": 524288,
            "minimum": 0,
            "title": "Output Bytes",
            "type": "integer"
          },
          "budget_stop": {
            "anyOf": [
              {
                "enum": [
                  "model_calls",
                  "input_budget",
                  "output_reservation",
                  "output_bytes",
                  "request_bytes",
                  "deadline",
                  "route",
                  "missing_output_cap",
                  "tool_set",
                  "stream_chunks"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Budget Stop"
          },
          "unconfirmed_calls": {
            "default": 0,
            "maximum": 16,
            "minimum": 0,
            "title": "Unconfirmed Calls",
            "type": "integer"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "maxProperties": 12,
            "title": "Timings",
            "type": "object"
          },
          "actual_usage": {
            "const": "unknown",
            "default": "unknown",
            "title": "Actual Usage",
            "type": "string"
          },
          "estimation": {
            "const": "ceil_utf8_bytes_div_2_not_tokenizer",
            "default": "ceil_utf8_bytes_div_2_not_tokenizer",
            "title": "Estimation",
            "type": "string"
          }
        },
        "required": [
          "model_calls",
          "input_estimated_tokens",
          "output_reserved_tokens",
          "output_bytes"
        ],
        "title": "RuntimeMetrics",
        "type": "object"
      },
      "TokenUsage": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "default": "unknown",
            "enum": [
              "known",
              "unknown"
            ],
            "title": "State",
            "type": "string"
          },
          "input_cache_hit_tokens": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Cache Hit Tokens"
          },
          "input_cache_miss_tokens": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Cache Miss Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Tokens"
          }
        },
        "title": "TokenUsage",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "完成是交付状态；answer_status单独说明教学/证据结果是否受限。",
    "properties": {
      "api_version": {
        "const": "dsh-tutor.v1",
        "title": "Api Version",
        "type": "string"
      },
      "operation_id": {
        "pattern": "^[a-f0-9]{32}$",
        "title": "Operation Id",
        "type": "string"
      },
      "request_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "title": "Request Id",
        "type": "string"
      },
      "state": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "recovery_required"
        ],
        "title": "State",
        "type": "string"
      },
      "stage": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Stage",
        "type": "string"
      },
      "error_code": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error Code"
      },
      "result": {
        "anyOf": [
          {
            "$ref": "#/$defs/OperationResult"
          },
          {
            "type": "null"
          }
        ]
      },
      "cancel_requested": {
        "title": "Cancel Requested",
        "type": "boolean"
      },
      "execution_cancellation": {
        "default": "not_requested",
        "enum": [
          "not_requested",
          "requested",
          "not_dispatched",
          "late_success",
          "outcome_unknown"
        ],
        "title": "Execution Cancellation",
        "type": "string"
      },
      "cancellation": {
        "enum": [
          "completed_after_cancel",
          "requested_unconfirmed",
          "not_running",
          "not_requested"
        ],
        "title": "Cancellation",
        "type": "string"
      },
      "deadline_exceeded": {
        "title": "Deadline Exceeded",
        "type": "boolean"
      },
      "feedback": {
        "additionalProperties": true,
        "title": "Feedback",
        "type": "object"
      },
      "events": {
        "$ref": "#/$defs/EventPage"
      },
      "created_at": {
        "maxLength": 64,
        "title": "Created At",
        "type": "string"
      },
      "updated_at": {
        "maxLength": 64,
        "title": "Updated At",
        "type": "string"
      },
      "retry_policy": {
        "const": "reuse_same_request_id; no_automatic_inference_retry",
        "title": "Retry Policy",
        "type": "string"
      },
      "source": {
        "enum": [
          "simulation",
          "isolated_test"
        ],
        "title": "Source",
        "type": "string"
      }
    },
    "required": [
      "api_version",
      "operation_id",
      "request_id",
      "state",
      "stage",
      "result",
      "cancel_requested",
      "cancellation",
      "deadline_exceeded",
      "events",
      "created_at",
      "updated_at",
      "retry_policy",
      "source"
    ],
    "title": "OperationView",
    "type": "object"
  },
  "settings": {
    "$defs": {
      "HttpBudgetSettings": {
        "additionalProperties": false,
        "description": "每类已认证请求的固定窗口限额；有界鉴权线程另保留类别配额。",
        "properties": {
          "submit_per_second": {
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "title": "Submit Per Second",
            "type": "integer"
          },
          "query_per_second": {
            "default": 40,
            "maximum": 200,
            "minimum": 1,
            "title": "Query Per Second",
            "type": "integer"
          },
          "cancel_per_second": {
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "title": "Cancel Per Second",
            "type": "integer"
          },
          "resolver_timeout_seconds": {
            "default": 0.5,
            "exclusiveMinimum": 0,
            "maximum": 2,
            "title": "Resolver Timeout Seconds",
            "type": "number"
          }
        },
        "title": "HttpBudgetSettings",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "request_issued_floor": {
        "default": 0,
        "minimum": 0,
        "title": "Request Issued Floor",
        "type": "integer"
      },
      "http_budget": {
        "$ref": "#/$defs/HttpBudgetSettings"
      },
      "max_operations": {
        "default": 1000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Max Operations",
        "type": "integer"
      },
      "max_journal_bytes": {
        "default": 16777216,
        "maximum": 67108864,
        "minimum": 65536,
        "title": "Max Journal Bytes",
        "type": "integer"
      },
      "max_result_bytes": {
        "default": 65536,
        "maximum": 65536,
        "minimum": 1024,
        "title": "Max Result Bytes",
        "type": "integer"
      },
      "max_inflight": {
        "default": 5,
        "maximum": 32,
        "minimum": 1,
        "title": "Max Inflight",
        "type": "integer"
      },
      "operation_timeout_seconds": {
        "default": 240.0,
        "exclusiveMinimum": 0,
        "maximum": 600,
        "title": "Operation Timeout Seconds",
        "type": "number"
      },
      "database_timeout_seconds": {
        "default": 0.1,
        "exclusiveMinimum": 0,
        "maximum": 1,
        "title": "Database Timeout Seconds",
        "type": "number"
      },
      "max_body_bytes": {
        "default": 32768,
        "maximum": 65536,
        "minimum": 1024,
        "title": "Max Body Bytes",
        "type": "integer"
      },
      "events_per_operation": {
        "default": 24,
        "maximum": 32,
        "minimum": 16,
        "title": "Events Per Operation",
        "type": "integer"
      },
      "endpoint_timeout_seconds": {
        "default": 3.0,
        "exclusiveMinimum": 0,
        "maximum": 10,
        "title": "Endpoint Timeout Seconds",
        "type": "number"
      },
      "profile": {
        "default": "simulation",
        "enum": [
          "simulation",
          "isolated_test"
        ],
        "title": "Profile",
        "type": "string"
      }
    },
    "title": "ServiceSettings",
    "type": "object"
  }
}