{
  "$defs": {
    "CourseSnapshot": {
      "additionalProperties": false,
      "description": "由可信调用方提供当前版本资料；课程内容本身不能授予工具权限。",
      "properties": {
        "course_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "lesson_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Lesson Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "locale": {
          "default": "zh-CN",
          "maxLength": 35,
          "minLength": 2,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Locale",
          "type": "string"
        },
        "goals": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Goals",
          "type": "array"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Instructions",
          "type": "array"
        }
      },
      "required": [
        "course_id",
        "version",
        "lesson_id",
        "title"
      ],
      "title": "CourseSnapshot",
      "type": "object"
    },
    "DirectAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "material_block",
            "learning_goal",
            "service_status"
          ],
          "title": "Kind",
          "type": "string"
        },
        "block_id": {
          "anyOf": [
            {
              "pattern": "^b[0-9]{3,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "service": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DirectAction",
      "type": "object"
    },
    "MaterialContext": {
      "additionalProperties": false,
      "description": "精确来源与摘录范围；图片未识别和摘录不全必须显式标记。",
      "properties": {
        "source_filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "anchor": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "excerpts": {
          "items": {
            "$ref": "#/$defs/MaterialExcerpt"
          },
          "maxItems": 12,
          "title": "Excerpts",
          "type": "array"
        },
        "excerpt_only": {
          "title": "Excerpt Only",
          "type": "boolean"
        },
        "images_interpreted": {
          "default": false,
          "title": "Images Interpreted",
          "type": "boolean"
        },
        "omitted_code_blocks": {
          "default": 0,
          "minimum": 0,
          "title": "Omitted Code Blocks",
          "type": "integer"
        }
      },
      "required": [
        "source_filename",
        "source_sha256",
        "anchor",
        "excerpts",
        "excerpt_only"
      ],
      "title": "MaterialContext",
      "type": "object"
    },
    "MaterialExcerpt": {
      "additionalProperties": false,
      "description": "摘录在提取块中的字符范围，用于追溯原文；不是执行授权。",
      "properties": {
        "block_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "MaterialExcerpt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "course": {
      "$ref": "#/$defs/CourseSnapshot"
    },
    "action": {
      "$ref": "#/$defs/DirectAction"
    }
  },
  "required": [
    "request_id",
    "course",
    "action"
  ],
  "title": "ActionRequest",
  "type": "object"
}