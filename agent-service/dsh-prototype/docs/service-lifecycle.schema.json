{
  "request_window_trusted_host_only": {
    "additionalProperties": false,
    "description": "仅可信认证宿主创建；学生提交的批次ID不是签名或授权。",
    "properties": {
      "nonce": {
        "pattern": "^[0-9a-f]{32}$",
        "title": "Nonce",
        "type": "string"
      },
      "issued_at": {
        "minimum": 0,
        "title": "Issued At",
        "type": "integer"
      },
      "expires_at": {
        "exclusiveMinimum": 0,
        "title": "Expires At",
        "type": "integer"
      }
    },
    "required": [
      "nonce",
      "issued_at",
      "expires_at"
    ],
    "title": "RequestWindow",
    "type": "object"
  },
  "retention": {
    "additionalProperties": false,
    "properties": {
      "max_operations": {
        "default": 100,
        "maximum": 100,
        "minimum": 1,
        "title": "Max Operations",
        "type": "integer"
      },
      "result_seconds": {
        "default": 86400.0,
        "maximum": 31536000,
        "minimum": 1,
        "title": "Result Seconds",
        "type": "number"
      },
      "expiry_grace_seconds": {
        "default": 3600.0,
        "maximum": 31536000,
        "minimum": 0,
        "title": "Expiry Grace Seconds",
        "type": "number"
      }
    },
    "title": "RetentionLimits",
    "type": "object"
  },
  "cleanup": {
    "additionalProperties": false,
    "properties": {
      "max_entries": {
        "default": 64,
        "maximum": 256,
        "minimum": 1,
        "title": "Max Entries",
        "type": "integer"
      },
      "max_runs": {
        "default": 10,
        "maximum": 32,
        "minimum": 1,
        "title": "Max Runs",
        "type": "integer"
      },
      "max_files": {
        "default": 256,
        "maximum": 512,
        "minimum": 1,
        "title": "Max Files",
        "type": "integer"
      },
      "max_bytes": {
        "default": 33554432,
        "maximum": 67108864,
        "minimum": 1,
        "title": "Max Bytes",
        "type": "integer"
      },
      "max_depth": {
        "default": 8,
        "maximum": 12,
        "minimum": 1,
        "title": "Max Depth",
        "type": "integer"
      },
      "min_age_seconds": {
        "default": 86400.0,
        "maximum": 31536000,
        "minimum": 0,
        "title": "Min Age Seconds",
        "type": "number"
      },
      "deadline_seconds": {
        "default": 2.0,
        "exclusiveMinimum": 0,
        "maximum": 10,
        "title": "Deadline Seconds",
        "type": "number"
      }
    },
    "title": "CleanupLimits",
    "type": "object"
  },
  "resources": {
    "$defs": {
      "ConversationLimits": {
        "additionalProperties": false,
        "description": "可信调用方可调小预算；硬上限避免小模型被长历史压满。字符数不是token数。",
        "properties": {
          "max_turns": {
            "default": 4,
            "maximum": 4,
            "minimum": 0,
            "title": "Max Turns",
            "type": "integer"
          },
          "max_history_chars": {
            "default": 2400,
            "maximum": 4000,
            "minimum": 0,
            "title": "Max History Chars",
            "type": "integer"
          }
        },
        "title": "ConversationLimits",
        "type": "object"
      },
      "HistoryReadLimits": {
        "additionalProperties": false,
        "description": "最多一次有界查询；不因查不到完整对话就扫描整个历史库。",
        "properties": {
          "max_scan_turns": {
            "default": 16,
            "maximum": 16,
            "minimum": 1,
            "title": "Max Scan Turns",
            "type": "integer"
          },
          "recent_turns": {
            "default": 4,
            "maximum": 4,
            "minimum": 1,
            "title": "Recent Turns",
            "type": "integer"
          }
        },
        "title": "HistoryReadLimits",
        "type": "object"
      },
      "MemoryLimits": {
        "additionalProperties": false,
        "properties": {
          "max_item_chars": {
            "default": 300,
            "maximum": 300,
            "minimum": 1,
            "title": "Max Item Chars",
            "type": "integer"
          },
          "max_prompt_chars": {
            "default": 1200,
            "maximum": 1600,
            "minimum": 0,
            "title": "Max Prompt Chars",
            "type": "integer"
          }
        },
        "title": "MemoryLimits",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "由管理员维护；validated_max_active是人工声明，必须另附实际容量证据。",
    "properties": {
      "max_active": {
        "default": 1,
        "maximum": 32,
        "minimum": 1,
        "title": "Max Active",
        "type": "integer"
      },
      "validated_max_active": {
        "default": 1,
        "maximum": 32,
        "minimum": 1,
        "title": "Validated Max Active",
        "type": "integer"
      },
      "max_waiting": {
        "default": 4,
        "maximum": 128,
        "minimum": 0,
        "title": "Max Waiting",
        "type": "integer"
      },
      "max_per_student": {
        "default": 1,
        "maximum": 8,
        "minimum": 1,
        "title": "Max Per Student",
        "type": "integer"
      },
      "queue_timeout_seconds": {
        "default": 10.0,
        "exclusiveMinimum": 0,
        "maximum": 60,
        "title": "Queue Timeout Seconds",
        "type": "number"
      },
      "max_finishing": {
        "default": 2,
        "maximum": 16,
        "minimum": 1,
        "title": "Max Finishing",
        "type": "integer"
      },
      "finishing_queue_timeout_seconds": {
        "default": 10.0,
        "exclusiveMinimum": 0,
        "maximum": 60,
        "title": "Finishing Queue Timeout Seconds",
        "type": "number"
      },
      "min_free_bytes": {
        "default": 268435456,
        "minimum": 0,
        "title": "Min Free Bytes",
        "type": "integer"
      },
      "max_preparing": {
        "default": 2,
        "maximum": 8,
        "minimum": 1,
        "title": "Max Preparing",
        "type": "integer"
      },
      "preparation_queue_timeout_seconds": {
        "default": 5.0,
        "exclusiveMinimum": 0,
        "maximum": 60,
        "title": "Preparation Queue Timeout Seconds",
        "type": "number"
      },
      "preparation_timeout_seconds": {
        "default": 3.0,
        "exclusiveMinimum": 0,
        "maximum": 30,
        "title": "Preparation Timeout Seconds",
        "type": "number"
      },
      "revalidation_timeout_seconds": {
        "default": 2.0,
        "exclusiveMinimum": 0,
        "maximum": 30,
        "title": "Revalidation Timeout Seconds",
        "type": "number"
      },
      "conversation": {
        "$ref": "#/$defs/ConversationLimits"
      },
      "history": {
        "$ref": "#/$defs/HistoryReadLimits"
      },
      "memory": {
        "$ref": "#/$defs/MemoryLimits"
      }
    },
    "title": "ResourcePolicy",
    "type": "object"
  }
}