{
  "adapter": "sqlite",
  "database_path": "data/chat/chat.sqlite3",
  "limits": {
    "busy_timeout_ms": 1000,
    "max_db_bytes": 67108864,
    "max_turns_per_context": 10000,
    "max_contexts": 1000,
    "page_limit": 20
  },
  "session": {
    "history_read_limits": {
      "max_scan_turns": 16
    },
    "conversation_limits": {
      "max_turns": 4,
      "max_history_chars": 2400
    },
    "enable_learning_memory": false,
    "memory_limits": {
      "max_item_chars": 300,
      "max_prompt_chars": 1200
    }
  }
}