# AIVirTeach libvirt learner image module defaults

AIVIRTEACH_ROOT="/var/lib/libvirt/images/aivirteach"
BASE_DIR="${AIVIRTEACH_ROOT}/base"
LABS_DIR="${AIVIRTEACH_ROOT}/labs"
SEEDS_DIR="${AIVIRTEACH_ROOT}/seeds"
STATE_DIR="/var/lib/aivirteach-labs"

UBUNTU_RELEASE="24.04"
UBUNTU_CODENAME="noble"
ARCH="amd64"
UBUNTU_IMAGE_NAME="ubuntu-24.04-server-cloudimg-amd64.img"
UBUNTU_IMAGE_BASE_URL="https://cloud-images.ubuntu.com/releases/noble/release"

GOLDEN_IMAGE_NAME="ubuntu-24.04-xfce-xrdp-v3.qcow2"
GOLDEN_IMAGE_SIZE="40G"
BUILDER_VM_NAME="avt-template-builder"
BUILDER_MEMORY_MB="4096"
BUILDER_VCPUS="2"
BUILD_TIMEOUT_SECONDS="3600"

LEARNER_MEMORY_MB="4096"
LEARNER_VCPUS="2"
LIBVIRT_NETWORK="default"
RDP_PORT="3389"

# Optional executable shell script to run inside the golden-image builder.
# Use an absolute path. Leave blank to skip custom provisioning.
CUSTOMIZE_SCRIPT=""

# Optional JPG/PNG installed as the XFCE desktop and LightDM login background.
# The builder accepts assets only from this module's general/ directory.
WALLPAPER_IMAGE="${MODULE_DIR}/general/logo.jpg"
