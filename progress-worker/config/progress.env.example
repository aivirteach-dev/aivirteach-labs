# Stable ID for this Labs host. It must match workerId in the Server assignment.
AIVIRTEACH_PROGRESS_WORKER_ID=labs-host-01

# Server API base and a worker-bound machine token. On the Server the same
# secret is the labs-host-01 entry in PROGRESS_WORKER_TOKENS.
AIVIRTEACH_PROGRESS_SERVER_URL=http://127.0.0.1:4000/api/v1
AIVIRTEACH_PROGRESS_SERVER_TOKEN=replace-with-a-different-random-token

# Progress-only Diagnostic Gateway credential. It cannot invoke journal, file,
# container, network, or other Agent diagnostic tools.
AIVIRTEACH_DIAGNOSTIC_URL=http://127.0.0.1:8765
AIVIRTEACH_PROGRESS_DIAGNOSTIC_TOKEN=replace-with-the-progress-only-diagnostic-token

AIVIRTEACH_PROGRESS_DB=/var/lib/aivirteach-progress/progress.sqlite3
AIVIRTEACH_PROGRESS_POLL_SECONDS=10
AIVIRTEACH_PROGRESS_HEARTBEAT_SECONDS=300
AIVIRTEACH_PROGRESS_REQUEST_TIMEOUT=50
AIVIRTEACH_PROGRESS_BATCH_SIZE=50
AIVIRTEACH_PROGRESS_MAX_PROBES_PER_TARGET=3
AIVIRTEACH_PROGRESS_UNKNOWN_BACKOFF_MAX_SECONDS=300
AIVIRTEACH_PROGRESS_RETRY_BASE_SECONDS=2
AIVIRTEACH_PROGRESS_RETRY_MAX_SECONDS=300
